"""Live streaming interface for feeding real-time events into the viewer."""

from __future__ import annotations

from dataclasses import dataclass
from queue import Queue
from typing import Iterable, Protocol

from .event_types import SnapshotEvent
from .renderer import Renderer


class EventSource(Protocol):
    """پروتکل منبع رویداد زنده."""
    def start(self) -> None: ...
    def stop(self) -> None: ...
    def next_event(self) -> SnapshotEvent | None: ...


@dataclass
class LiveSessionConfig:
    """تنظیمات جلسهٔ زنده."""
    poll_timeout_s: float = 0.05
    auto_start_source: bool = True


@dataclass
class LiveSession:
    """مدیریت حلقهٔ اصلی برای رسیدن رویدادهای زنده به رندرر."""

    renderer: Renderer
    source: EventSource
    config: LiveSessionConfig = LiveSessionConfig()

    def run_once(self) -> None:
        """خواندن یک رویداد (در صورت وجود) و انتقال به renderer."""
        event = self.source.next_event()
        if event is not None:
            self.renderer.feed_event(event)

    def run_forever(self) -> None:
        """حلقهٔ اصلی (blocking) تا توقف دستی."""
        if self.config.auto_start_source:
            self.source.start()

        try:
            while True:
                self.run_once()
                # TODO: مدیریت وقفه، زمان‌بندی و رویدادهای سیستمی
        finally:
            self.source.stop()


@dataclass
class QueueEventSource:
    """منبع ساده رویداد: queue.Queue از نخ/فرایند دیگر تغذیه می‌شود."""

    queue: Queue[SnapshotEvent]

    def start(self) -> None:
        """Nothing to do for queue-based source."""

    def stop(self) -> None:
        """Nothing to do for queue-based source."""

    def next_event(self) -> SnapshotEvent | None:
        """خواندن بدون بلاک (non-blocking) از صف."""
        if self.queue.empty():
            return None
        return self.queue.get_nowait()