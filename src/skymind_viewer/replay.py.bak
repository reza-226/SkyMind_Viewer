src/skymind_viewer/replay.py
from __future__ import annotations

import json
import bisect
from typing import List, Dict, Any, Optional, Callable

from skymind_viewer.event_types import AnyEvent
from skymind_viewer.validation import validate_events

class ReplayStream:
    """
    JSONL replay reader with indexing and seeking support.
    """
    def __init__(self, file_path: str):
        self.file_path = file_path
        self.events: List[AnyEvent] = []
        self.times: List[float] = []
        self._load()
        self.ptr: int = 0
        self.on_event: Optional[Callable[[AnyEvent], None]] = None

    def _load(self):
        with open(self.file_path, "r", encoding="utf-8") as f:
            for i, line in enumerate(f):
                if not line.strip():
                    continue
                evt = json.loads(line)
                evt["idx"] = i
                t = evt.get("t", None)
                if t is None:
                    t = float(i)
                    evt["t"] = t
                self.events.append(evt)
                self.times.append(float(t))
        if not self.events:
            raise ValueError(f"No events in replay file: {self.file_path}")
        self.start_time = self.times[0]
        self.end_time = self.times[-1]
        self.total = len(self.events)

    def current(self) -> AnyEvent:
        return self.events[self.ptr]

    def progress(self) -> float:
        if self.total <= 1:
            return 1.0
        return self.ptr / (self.total - 1)

    def duration(self) -> float:
        return self.end_time - self.start_time

    def seek_index(self, idx: int):
        self.ptr = max(0, min(self.total - 1, idx))

    def seek_percent(self, p: float):
        p = max(0.0, min(1.0, p))
        idx = int(round(p * (self.total - 1)))
        self.seek_index(idx)

    def seek_time(self, t: float):
        pos = bisect.bisect_left(self.times, t)
        if pos >= self.total:
            pos = self.total - 1
        self.seek_index(pos)

    def step(self, delta: int = 1):
        new_ptr = self.ptr + delta
        self.ptr = max(0, min(self.total - 1, new_ptr))

    def emit_current(self):
        if self.on_event:
            self.on_event(self.current())

    def validate_schema(self) -> Dict[str, int]:
        """
        Stricter schema validation using skymind_viewer.validation.validate_events
        Returns counters dictionary including __errors__ and __warnings__.
        """
        result = validate_events(self.events)
        return result.counters
