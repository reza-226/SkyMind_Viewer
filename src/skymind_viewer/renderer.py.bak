src/skymind_viewer/renderer.py
from __future__ import annotations

import pygame as pg
from typing import Tuple, Optional, List

from skymind_viewer.replay import ReplayStream
from skymind_viewer.state import ViewerState
from skymind_viewer.camera import Camera

class Seekbar:
    def __init__(self, rect: pg.Rect, fg=(80, 180, 250), bg=(40, 40, 40), knob=(255, 255, 255)):
        self.rect = rect
        self.fg = fg
        self.bg = bg
        self.knob = knob
        self.dragging = False

    def draw(self, surface: pg.Surface, replay: ReplayStream):
        pg.draw.rect(surface, self.bg, self.rect, border_radius=6)
        p = replay.progress()
        w_prog = int(self.rect.width * p)
        prog_rect = pg.Rect(self.rect.left, self.rect.top, w_prog, self.rect.height)
        pg.draw.rect(surface, self.fg, prog_rect, border_radius=6)
        knob_x = self.rect.left + w_prog
        knob_rect = pg.Rect(knob_x - 4, self.rect.top, 8, self.rect.height)
        pg.draw.rect(surface, self.knob, knob_rect, border_radius=4)

    def handle_event(self, e: pg.event.Event, replay: ReplayStream):
        if e.type == pg.MOUSEBUTTONDOWN and e.button == 1:
            if self.rect.collidepoint(e.pos):
                self.dragging = True
                self._seek_to_mouse(e.pos, replay)
        elif e.type == pg.MOUSEBUTTONUP and e.button == 1:
            if self.dragging:
                self.dragging = False
                self._seek_to_mouse(e.pos, replay)
        elif e.type == pg.MOUSEMOTION and self.dragging:
            self._seek_to_mouse(e.pos, replay)

    def _seek_to_mouse(self, pos: Tuple[int, int], replay: ReplayStream):
        x = pos[0]
        p = (x - self.rect.left) / max(1, self.rect.width)
        replay.seek_percent(p)

class Renderer:
    """
    Renderer with Camera world_to_screen, seekbar, overlay and layer protocol.
    - Play/Pause toggle (SPACE), step +/- (PageUp/PageDown), Home/End.
    - Pan with arrow keys, Zoom with Z/X or mouse wheel.
    """
    def __init__(self, replay: ReplayStream, size=(1024, 768), bg_color=(20, 20, 24), headless=False):
        self.replay = replay
        self.size = size
        self.bg_color = bg_color
        self.headless = headless
        self.screen: Optional[pg.Surface] = None
        self.clock = pg.time.Clock()
        self.layers: List[object] = []
        self.state = ViewerState(viewport_size=size)
        self.seekbar = None
        self.playing = False
        self.speed = 1  # events per frame when playing

        self._init_pg()
        self._init_seekbar()

    def _init_pg(self):
        pg.init()
        if not self.headless:
            self.screen = pg.display.set_mode(self.size)
            pg.display.set_caption("Skymind Viewer")
        else:
            self.screen = pg.Surface(self.size)

    def _init_seekbar(self):
        w, h = self.size
        bar_h = 24
        rect = pg.Rect(16, h - bar_h - 12, w - 32, bar_h)
        self.seekbar = Seekbar(rect)

    def add_layer(self, layer):
        self.layers.append(layer)

    def _reduce_event(self, evt):
        # Update central state (entities, positions, time)
        self.state.sim_time = float(evt.get("t", self.state.sim_time))
        typ = evt.get("type")
        if typ == "entity_created":
            self.state.update_entity(evt["id"], evt["kind"], evt.get("label"), float(evt["x"]), float(evt["y"]))
        elif typ == "uav_pose":
            self.state.update_pose(evt["id"], float(evt["x"]), float(evt["y"]))

    def _handle_keys(self, e: pg.event.Event):
        if e.type == pg.KEYDOWN:
            if e.key == pg.K_SPACE:
                self.playing = not self.playing
            elif e.key == pg.K_PAGEUP:
                self.replay.step(-10)
            elif e.key == pg.K_PAGEDOWN:
                self.replay.step(+10)
            elif e.key == pg.K_HOME:
                self.replay.seek_index(0)
            elif e.key == pg.K_END:
                self.replay.seek_index(self.replay.total - 1)
            elif e.key == pg.K_UP:
                self.state.camera.pan(0, +20)
            elif e.key == pg.K_DOWN:
                self.state.camera.pan(0, -20)
            elif e.key == pg.K_LEFT:
                self.state.camera.pan(+20, 0)
            elif e.key == pg.K_RIGHT:
                self.state.camera.pan(-20, 0)
            elif e.key == pg.K_z:
                # zoom in centered at viewport center
                cx, cy = self.size[0] // 2, self.size[1] // 2
                self.state.camera.zoom_by(1.2, pivot_screen=(cx, cy))
            elif e.key == pg.K_x:
                cx, cy = self.size[0] // 2, self.size[1] // 2
                self.state.camera.zoom_by(1/1.2, pivot_screen=(cx, cy))

    def _handle_mouse(self, e: pg.event.Event):
        # Mouse wheel zoom
        if e.type == pg.MOUSEWHEEL:
            mx, my = pg.mouse.get_pos()
            if e.y > 0:
                self.state.camera.zoom_by(1.1, pivot_screen=(mx, my))
            elif e.y < 0:
                self.state.camera.zoom_by(1/1.1, pivot_screen=(mx, my))
        # Right button drag for panning
        if e.type == pg.MOUSEMOTION and e.buttons[2]:  # right button held
            dx, dy = e.rel
            self.state.camera.pan(dx, dy)

    def run(self, fps=30):
        running = True
        font = pg.font.SysFont("consolas", 14)

        while running:
            for e in pg.event.get():
                if e.type == pg.QUIT:
                    running = False
                self._handle_keys(e)
                self._handle_mouse(e)
                self.seekbar.handle_event(e, self.replay)

            # auto play
            if self.playing:
                for _ in range(self.speed):
                    self.replay.step(+1)

            # current event and state reduction
            evt = self.replay.current()
            self._reduce_event(evt)

            # propagate to layers
            for layer in self.layers:
                if hasattr(layer, "handle_event"):
                    layer.handle_event(evt, self.state)

            # draw pass
            self.screen.fill(self.bg_color)
            for layer in self.layers:
                if hasattr(layer, "draw"):
                    layer.draw(self.screen, self.state)

            # seekbar on top
            self.seekbar.draw(self.screen, self.replay)

            # overlay (status)
            self._draw_overlay(self.screen, font)

            if not self.headless:
                pg.display.flip()
            self.clock.tick(fps)

        pg.quit()

    def _draw_overlay(self, surface: pg.Surface, font: pg.font.Font):
        # top-left HUD with sim time, event idx, total, progress, zoom, playing
        idx = self.replay.ptr
        total = self.replay.total
        progress = int(self.replay.progress() * 100)
        status = "PLAY" if self.playing else "PAUSE"
        zoom = round(self.state.camera.scale, 2)
        offx = int(self.state.camera.offset_x)
        offy = int(self.state.camera.offset_y)
        lines = [
            f"t={self.state.sim_time:.3f}s  evt={idx}/{total} ({progress}%)",
            f"status={status}  speed={self.speed} ev/frame",
            f"zoom={zoom}  pan=({offx},{offy})",
        ]
        pad = 8
        x0, y0 = 12, 12
        # compute background box
        max_w = 0
        line_surfs = []
        for s in lines:
            ts = font.render(s, True, (220, 220, 220))
            line_surfs.append(ts)
            max_w = max(max_w, ts.get_width())
        box_h = sum(ts.get_height() for ts in line_surfs) + pad * 2
        box_w = max_w + pad * 2
        rect = pg.Rect(x0, y0, box_w, box_h)
        pg.draw.rect(surface, (0, 0, 0, 128), rect, border_radius=6)
        # blit lines
        y = y0 + pad
        for ts in line_surfs:
            surface.blit(ts, (x0 + pad, y))
            y += ts.get_height()
