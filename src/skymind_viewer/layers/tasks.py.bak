src/skymind_viewer/layers/tasks.py
from __future__ import annotations

import pygame as pg
from typing import Dict, List

from skymind_viewer.event_types import AnyEvent

class TaskQueueLayer:
    """
    Maintains per-entity task queues and draws queue indicators near entities.
    Camera transform (world_to_screen) is used for precise placement.
    """
    def __init__(self, font: pg.font.Font = None, color=(255, 220, 120)):
        self.queues: Dict[str, List[str]] = {}
        self.font = font or pg.font.SysFont("consolas", 14)
        self.color = color

    def handle_event(self, evt: AnyEvent, state):
        typ = evt.get("type")
        if typ == "entity_created":
            eid = evt["id"]
            self.queues.setdefault(eid, [])
        elif typ == "task_submit":
            src = evt["src"]
            tid = evt["task_id"]
            self.queues.setdefault(src, []).append(tid)
        elif typ in ("task_assigned", "offload_decision"):
            src = evt["src"]
            tid = evt["task_id"]
            q = self.queues.setdefault(src, [])
            try:
                q.remove(tid)
            except ValueError:
                pass
            dst = evt.get("dst")
            if dst:
                self.queues.setdefault(dst, []).append(tid)
        elif typ == "task_completed":
            dst = evt["dst"]
            tid = evt["task_id"]
            q = self.queues.setdefault(dst, [])
            try:
                q.remove(tid)
            except ValueError:
                pass

    def draw(self, surface: pg.Surface, state):
        for eid, info in state.entities.items():
            pos = state.positions.get(eid)
            if not pos:
                continue
            sx, sy = state.camera.world_to_screen(pos)
            badge_text = str(len(self.queues.get(eid, [])))
            text_surf = self.font.render(badge_text, True, self.color)
            rect = text_surf.get_rect()
            rect.center = (sx, sy - 18)
            # background circle
            pg.draw.circle(surface, (40, 40, 40), rect.center, max(10, rect.width // 2))
            surface.blit(text_surf, rect)
